{
  "name": "course-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "chakra typegen ./theme/system.ts",
    "postinstall": "npm run typegen",
    "prescrape": "npm run transpile",
    "scrape": "node ./scraper/src/scheduler/updateDB/run.js",
    "prescrape-dev": "npx tsc ./scraper/src/scheduler/updateDB/run.ts --target es2020 --module commonjs --moduleResolution node",
    "scrape-dev": "node -r dotenv/config ./scraper/src/scheduler/updateDB/run.js dotenv_config_path=./.env.local",
    "postscrape-dev": "bash ./cleanup.sh",
    "pretranspile": "npm install -g typescript",
    "transpile": "npx tsc ./scraper/src/scheduler/updateDB/run.ts --target es2020 --module commonjs --moduleResolution node",
    "cypress-dev": "cypress open",
    "cypress": "cypress run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "google-spreadsheet": "^5.3.0",
    "mongoose": "^9.9.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "cypress": "^15.17.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  },
  "cacheDirectories": [
    ".next/cache"
  ]
}
