# Copy to .env.local and fill in the values.

# MongoDB connection string. Required to run the site and the scraper.
MONGODB_URI=

# Value the scheduler sends in the Authorization header to /api/scrape.
# Any string works if you only scrape with npm run scrape-dev.
CRON_KEY=

# Google service account used by the scraper to read the survey sheet.
GOOGLE_CLIENT_EMAIL=
# Keep the key on one line with literal \n between lines.
GOOGLE_PRIVATE_KEY=
