{
  "name": "course-analytics-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run watch-compile\" \"npm run watch-dev\"",
    "watch-compile": "swc src -w --out-dir dist --strip-leading-paths",
    "watch-dev": "nodemon --watch \"dist/**/*\" -e js ./dist/server.js",
    "build": "swc src -d dist --strip-leading-paths",
    "start": "NODE_ENV=production node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "eslint --ext .ts src",
    "lint:fix": "eslint --ext .ts src --fix",
    "gcp-build": "npm run build",
    "deploy": "gcloud app deploy --no-cache"
  },
  "author": "Nic Nolan",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "google-spreadsheet": "^5.3.0",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/node": "^18.11.17",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "chokidar": "^5.0.0",
    "concurrently": "^7.6.0",
    "eslint": "^8.57.1",
    "nodemon": "^2.0.20",
    "typescript": "^5.9.0"
  }
}
